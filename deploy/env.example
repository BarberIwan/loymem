# Copy to deploy/.env and fill in. Never commit .env.
LOYMEM_DOMAIN=test.example.nl
POSTGRES_PASSWORD=
LOYMEM_OWNER_PASSWORD=
LOYMEM_APP_PASSWORD=
# Put the same two passwords in these URLs.
LOYMEM_MIGRATION_URL=postgresql+psycopg://loymem_owner:OWNER_PASSWORD@db:5432/loymem
LOYMEM_DATABASE_URL=postgresql+psycopg://loymem_app:APP_PASSWORD@db:5432/loymem
LOYMEM_SECRET_KEY=
# staging: secure cookies, payments in test mode. production: live payments.
LOYMEM_ENVIRONMENT=staging
LOYMEM_PUBLIC_BASE_URL=https://test.example.nl
LOYMEM_SIGNUP_CODE=
# Mail: leave log_only until the mail service is set up.
LOYMEM_EMAIL_DELIVERY=log_only
LOYMEM_MAIL_FROM_ADDRESS=
LOYMEM_SMTP_HOST=
LOYMEM_SMTP_PORT=587
LOYMEM_SMTP_USERNAME=
LOYMEM_SMTP_PASSWORD=
# Off until the legal check and the Mollie Connect app exist.
LOYMEM_MEMBERSHIPS_ENABLED=false
LOYMEM_MOLLIE_CLIENT_ID=
LOYMEM_MOLLIE_CLIENT_SECRET=
LOYMEM_WALLET_ENABLED=false
